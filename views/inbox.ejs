                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-12 0v1.5a6 6 0 0 0 6 6Zm0 0v3.75m-3.75 0h7.5M12 15a3 3 0 0 1-3-3V5.25a3 3 0 1 1 6 0V12a3 3 0 0 1-3 3Z" />
