    </div>
    <!-- import socket io client from cdn -->
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js" integrity="sha384-2huaZvOR9iDzHqslqwpR87isEmrfxqyWOF7hr7BY6KG0+hVKLoEXMPUJw3ynWuhO" crossorigin="anonymous"></script>
    <script src="./js/app.js"></script>

    <div id="attachment-viewer" class="attachment-viewer">
        <div class="attachment-viewer-card">
            <button id="attachment-viewer-close" class="attachment-viewer-close" type="button">×</button>
            <img id="attachment-viewer-img" src="" alt="Attachment preview">
        </div>
    </div>

    <div id="inbox-call-overlay" class="inbox-call-overlay hidden">
        <div class="inbox-call-card" data-call-type="video">
            <div class="inbox-call-video-area">
                <video id="inbox-remote-video" autoplay playsinline></video>
                <div id="inbox-remote-fallback" class="inbox-call-fallback">
                    <div id="inbox-call-avatar" class="inbox-call-avatar">--</div>
                    <div id="inbox-call-name" class="inbox-call-name">Contact</div>
                    <div id="inbox-call-status" class="inbox-call-status">Calling...</div>
                    <div id="inbox-call-timer" class="inbox-call-timer">00:00</div>
                </div>
                <div id="inbox-local-preview" class="inbox-local-preview">
                    <video id="inbox-local-video" autoplay playsinline muted></video>
                    <div id="inbox-local-fallback" class="inbox-local-fallback">Me</div>
                </div>
            </div>
            <div class="inbox-call-controls">
                <button type="button" id="inbox-call-mute" class="inbox-call-control" title="Mute" aria-label="Mute microphone">
                    <span class="inbox-call-icon mic"></span>
                    <span>Mute</span>
                </button>
                <button type="button" id="inbox-call-camera" class="inbox-call-control" title="Camera" aria-label="Turn camera off">
                    <span class="inbox-call-icon camera"></span>
                    <span>Camera</span>
                </button>
                <button type="button" id="inbox-call-speaker" class="inbox-call-control" title="Speaker" aria-label="Mute remote audio">
                    <span class="inbox-call-icon speaker"></span>
                    <span>Speaker</span>
                </button>
                <button type="button" id="inbox-call-end" class="inbox-call-control danger" title="End call" aria-label="End call">
                    <span class="inbox-call-icon end"></span>
                    <span>End</span>
                </button>
            </div>
        </div>
    </div>

    <div id="inbox-incoming-call" class="inbox-ringing-overlay hidden">
        <div class="inbox-ringing-card">
            <div id="inbox-incoming-avatar" class="inbox-call-avatar">--</div>
            <div id="inbox-incoming-title" class="inbox-ringing-title">Incoming call</div>
            <div id="inbox-incoming-subtitle" class="inbox-ringing-subtitle">Contact</div>
            <div class="inbox-ringing-actions">
                <button type="button" id="inbox-decline-call" class="inbox-round-call danger" title="Decline" aria-label="Decline call">
                    <span class="inbox-call-icon end"></span>
                </button>
                <button type="button" id="inbox-accept-call" class="inbox-round-call accept" title="Accept" aria-label="Accept call">
                    <span class="inbox-call-icon phone"></span>
                </button>
            </div>
        </div>
    </div>

    <script>
        const conversationDataset = <%- JSON.stringify(data || []) %>;
        const conversation_content_wrapper = document.querySelector("#conversation-content-wrapper");
        const chat_message_title_container = document.querySelector("#chat-message-title-container");
        const chat_message_avatar_container = document.querySelector("#chat-message-avatar-container");
        const chat_message_title_name = document.querySelector("#chat-message-title-name");
        const user_online_status_text_container = document.querySelector("#user-online-status-text-container");
        const chat_message_list = document.querySelector("#chat-message-list");
        const pinned_message_container = document.querySelector("#pinned-message-container");
        const chat_form_container = document.querySelector("#chat-form-container");
        const chat_back_btn = document.querySelector("#chat-back-btn");
        const main_content_wrapper = document.querySelector(".main-content-wrapper");
        const attachment_input = document.getElementById("attachment");
        const attachment_preview = document.getElementById("attachment-preview");
        const audio_record_btn = document.getElementById("audio-record-btn");
        const chat_message_input = document.getElementById("chat-message-input");
        const message_search_input = document.getElementById("message-search-input");
        const conversation_search_input = document.getElementById("conversation-search-input");
        const chat_message_block_container = document.querySelector(".chat-message-block-container");
        const blocked_message_form_container = document.querySelector(".blocked-message-form-container");
        const leave_group_item = document.querySelector("#leave-group-item");
        const clear_message_item = document.querySelector("#clear-message-item");
        const add_members_icon = document.querySelector("#add-members-icon");
        const inline_add_member_panel = document.querySelector("#inline-add-member-panel");
        const inline_add_member_input = document.querySelector("#inline-add-member-input");
        const inline_add_member_results = document.querySelector("#inline-add-member-results");
        const inline_add_member_close = document.querySelector("#inline-add-member-close");
        const attachment_viewer = document.querySelector("#attachment-viewer");
        const attachment_viewer_img = document.querySelector("#attachment-viewer-img");
        const attachment_viewer_close = document.querySelector("#attachment-viewer-close");
        const currentUserName = <%- JSON.stringify(loggedInUser?.username || "") %>;
        const currentUserAvatar = <%- JSON.stringify(loggedInUser?.avatar || "") %>;
        const typing_input_indicator = document.querySelector("#typing-indicator-input");
        const inbox_call_overlay = document.querySelector("#inbox-call-overlay");
        const inbox_call_card = document.querySelector(".inbox-call-card");
        const inbox_remote_video = document.querySelector("#inbox-remote-video");
        const inbox_local_video = document.querySelector("#inbox-local-video");
        const inbox_remote_fallback = document.querySelector("#inbox-remote-fallback");
        const inbox_local_fallback = document.querySelector("#inbox-local-fallback");
        const inbox_local_preview = document.querySelector("#inbox-local-preview");
        const inbox_call_avatar = document.querySelector("#inbox-call-avatar");
        const inbox_call_name = document.querySelector("#inbox-call-name");
        const inbox_call_status = document.querySelector("#inbox-call-status");
        const inbox_call_timer = document.querySelector("#inbox-call-timer");
        const inbox_call_mute = document.querySelector("#inbox-call-mute");
        const inbox_call_camera = document.querySelector("#inbox-call-camera");
        const inbox_call_speaker = document.querySelector("#inbox-call-speaker");
        const inbox_call_end = document.querySelector("#inbox-call-end");
        const inbox_incoming_call = document.querySelector("#inbox-incoming-call");
        const inbox_incoming_avatar = document.querySelector("#inbox-incoming-avatar");
        const inbox_incoming_title = document.querySelector("#inbox-incoming-title");
        const inbox_incoming_subtitle = document.querySelector("#inbox-incoming-subtitle");
        const inbox_accept_call = document.querySelector("#inbox-accept-call");
        const inbox_decline_call = document.querySelector("#inbox-decline-call");
        const header_dots_dropdown = document.querySelector("#header-dots-dropdown");
        const message_dots_dropdown = document.querySelector("#message-dots-dropdown");

        const currentUserId = window.loggedInUserId || document.querySelector("meta[name=\"userId\"]")?.getAttribute("content");
        const socketRef = typeof socket !== "undefined" ? socket : io();
        let onlineUsersList = [];
        const userPresence = new Map();

        let current_conversation_id = null;
        let participant = null;
        let currentConversation = null;
        let pagination = { loading: false, hasMore: false, nextBefore: null };
        let pinnedMessages = [];
        let activePinnedIndex = 0;
        let attachmentFiles = [];
        let mediaRecorder = null;
        let audioRecordChunks = [];
        let audioRecordStream = null;
        let audioRecordStartedAt = null;
        let inlineMemberTimer = null;
        let typingTimeout = null;
        let conversationSearchTimer = null;
        let messageSelectionMode = false;
        let activeParticipantUser = null;
        const typingByConversation = new Map();
        let callPeerConnection = null;
        let callLocalStream = null;
        let callRemoteStream = null;
        let callTargetId = null;
        let callPeerName = "";
        let inboxCallType = "video";
        let pendingIncomingCall = null;
        let callRingingTimeout = null;
        let callTimerInterval = null;
        let callStartedAt = null;
        let queuedCallCandidates = [];
        let isCallMuted = false;
        let isCallCameraOff = false;
        let isRemoteAudioMuted = false;
        const CALL_ICE_CONFIG = {
            iceServers: [{ urls: "stun:stun.l.google.com:19302" }],
        };

        socketRef.on("conversation_created", ({ conversation }) => {
            if (!conversation || !conversation._id) return;
            const isMember =
                String(conversation.creator?.id) === String(currentUserId) ||
                String(conversation.participant?.id) === String(currentUserId) ||
                (conversation.members || []).some((member) => String(member.id) === String(currentUserId));
            if (!isMember) return;
            const exists = (conversationDataset || []).some((item) => String(item._id) === String(conversation._id));
            if (!exists) {
                conversationDataset.unshift(conversation);
                renderConversationList(conversationDataset);
            }
        });

        socketRef.on("online-users", (onlineUserIds) => {
            onlineUsersList = (onlineUserIds || []).map(String);
            onlineUsersList.forEach((userId) => {
                userPresence.set(String(userId), {
                    onlineStatus: "Online",
                    lastSeen: new Date().toISOString(),
                });
            });
            updateOnlineStatusText();
            updateConversationStatusBadges();
        });

        socketRef.on("user_status", ({ userId, onlineStatus, lastSeen }) => {
            if (!userId) return;
            const id = String(userId);
            userPresence.set(id, {
                onlineStatus: onlineStatus || (onlineUsersList.includes(id) ? "Online" : "Offline"),
                lastSeen: lastSeen || new Date().toISOString(),
            });
            if (onlineStatus === "Online" && !onlineUsersList.includes(id)) {
                onlineUsersList.push(id);
            }
            if (onlineStatus === "Offline") {
                onlineUsersList = onlineUsersList.filter((onlineId) => onlineId !== id);
            }
            updateOnlineStatusText();
            updateConversationStatusBadges();
        });

        socketRef.on("typing", ({ conversationId, senderId, senderName, isGroup }) => {
            if (!conversationId || senderId === currentUserId) return;
            const entry = typingByConversation.get(conversationId) || {
                senders: new Map(),
                isGroup: !!isGroup,
                timers: new Map(),
            };
            entry.isGroup = !!isGroup;
            entry.senders.set(senderId, senderName || "Someone");
            if (entry.timers?.has(senderId)) clearTimeout(entry.timers.get(senderId));
            entry.timers.set(senderId, setTimeout(() => {
                const nextEntry = typingByConversation.get(conversationId);
                if (!nextEntry) return;
                nextEntry.senders.delete(senderId);
                nextEntry.timers?.delete(senderId);
                if (nextEntry.senders.size === 0) {
                    typingByConversation.delete(conversationId);
                } else {
                    typingByConversation.set(conversationId, nextEntry);
                }
                updateTypingForConversation(conversationId);
            }, 3500));
            typingByConversation.set(conversationId, entry);
            updateTypingForConversation(conversationId);
        });

        socketRef.on("stop-typing", ({ conversationId, senderId }) => {
            if (!conversationId || !typingByConversation.has(conversationId)) return;
            const entry = typingByConversation.get(conversationId);
            if (entry.timers?.has(senderId)) {
                clearTimeout(entry.timers.get(senderId));
                entry.timers.delete(senderId);
            }
            entry.senders.delete(senderId);
            if (entry.senders.size === 0) {
                typingByConversation.delete(conversationId);
            } else {
                typingByConversation.set(conversationId, entry);
            }
            updateTypingForConversation(conversationId);
        });

        function toggleChatPanel(show) {
            if (!main_content_wrapper) return;
            if (show) {
                main_content_wrapper.classList.add("show-chat-panel");
            } else {
                main_content_wrapper.classList.remove("show-chat-panel");
            }
        }

        if (chat_back_btn) {
            chat_back_btn.addEventListener("click", () => toggleChatPanel(false));
        }

        if (add_members_icon) {
            add_members_icon.addEventListener("click", (event) => {
                event.preventDefault();
                event.stopPropagation();
                if (!current_conversation_id || !participant) return;
                openInlineAddMember();
            });
        }

        document.querySelectorAll(".call-action-btn[data-call-type]").forEach((button) => {
            button.addEventListener("click", (event) => {
                event.preventDefault();
                if (!participant || participant.isGroup || !participant.id) {
                    showCallNotice("Select a one-to-one chat to call.");
                    return;
                }
                const type = button.dataset.callType === "voice" ? "audio" : "video";
                startInboxCall(participant.id, type, participant.name || participant.id);
            });
        });

        if (inbox_call_mute) {
            inbox_call_mute.addEventListener("click", () => {
                if (!callLocalStream) return;
                isCallMuted = !isCallMuted;
                callLocalStream.getAudioTracks().forEach((track) => {
                    track.enabled = !isCallMuted;
                });
                updateInboxCallControls();
            });
        }

        if (inbox_call_camera) {
            inbox_call_camera.addEventListener("click", () => {
                if (inboxCallType !== "video") {
                    showCallNotice("Video is off for this call");
                    return;
                }
                if (!callLocalStream) return;
                isCallCameraOff = !isCallCameraOff;
                callLocalStream.getVideoTracks().forEach((track) => {
                    track.enabled = !isCallCameraOff;
                });
                if (inbox_local_fallback) inbox_local_fallback.classList.toggle("hidden", !isCallCameraOff);
                updateInboxCallControls();
            });
        }

        if (inbox_call_speaker) {
            inbox_call_speaker.addEventListener("click", () => {
                isRemoteAudioMuted = !isRemoteAudioMuted;
                if (inbox_remote_video) inbox_remote_video.muted = isRemoteAudioMuted;
                updateInboxCallControls();
            });
        }

        if (inbox_call_end) {
            inbox_call_end.addEventListener("click", () => endInboxCall({ notifyPeer: true }));
        }

        if (inbox_accept_call) {
            inbox_accept_call.addEventListener("click", () => acceptInboxCall());
        }

        if (inbox_decline_call) {
            inbox_decline_call.addEventListener("click", () => {
                if (!pendingIncomingCall) return;
                socketRef.emit("reject-call", { to: pendingIncomingCall.from, from: currentUserId });
                pendingIncomingCall = null;
                clearCallRingingTimeout();
                hideIncomingCallOverlay();
            });
        }

        window.addEventListener("beforeunload", () => {
            if (callTargetId) {
                socketRef.emit("end-call", { to: callTargetId, from: currentUserId });
            }
        });

        if (header_dots_dropdown) {
            header_dots_dropdown.addEventListener("click", (event) => {
                const actionBtn = event.target.closest("[data-header-action]");
                if (!actionBtn) return;
                event.preventDefault();
                handleHeaderDropdownAction(actionBtn.dataset.headerAction);
                header_dots_dropdown.classList.remove("active");
            });
        }

        if (message_dots_dropdown) {
            message_dots_dropdown.addEventListener("click", (event) => {
                const actionBtn = event.target.closest("[data-conversation-action]");
                if (!actionBtn) return;
                event.preventDefault();
                handleConversationDropdownAction(actionBtn.dataset.conversationAction);
                message_dots_dropdown.classList.remove("active");
            });
        }

        function handleHeaderDropdownAction(action) {
            if (action === "new-message") {
                const trigger = document.querySelector(".conversation-create-btn");
                if (trigger) trigger.dispatchEvent(new Event("click", { bubbles: true }));
                return;
            }
            if (action === "select-chats") {
                document.body.classList.toggle("conversation-select-mode");
                toastr.info(document.body.classList.contains("conversation-select-mode") ? "Select chats mode on." : "Select chats mode off.");
                return;
            }
            if (action === "settings") {
                const widgetToggle = document.querySelector(".widget-toggle");
                if (widgetToggle) widgetToggle.click();
            }
        }

        function handleConversationDropdownAction(action) {
            if (!action) return;
            if (!current_conversation_id && !["close", "report"].includes(action)) {
                toastr.warning("Select a conversation first.");
                return;
            }
            if (action === "info") {
                if (!participant) {
                    toastr.warning("Select a conversation first.");
                    return;
                }
                const info = participant.isGroup
                    ? `${participant.name}: ${participant.members?.length || participant.memberCount || 0} members`
                    : `${participant.name}: ${getPresenceLabel(participant.id).label}`;
                toastr.info(info);
                return;
            }
            if (action === "select-messages") {
                messageSelectionMode = !messageSelectionMode;
                chat_message_list?.classList.toggle("message-select-mode", messageSelectionMode);
                toastr.info(messageSelectionMode ? "Message selection enabled." : "Message selection disabled.");
                return;
            }
            if (action === "close") {
                closeCurrentConversation();
                return;
            }
            if (action === "mute") {
                const key = `muted-conversation-${current_conversation_id}`;
                const muted = localStorage.getItem(key) === "1";
                localStorage.setItem(key, muted ? "0" : "1");
                toastr.success(muted ? "Notifications unmuted." : "Notifications muted.");
                return;
            }
            if (action === "delete") {
                deleteMeassage();
                return;
            }
            if (action === "clear") {
                clearMessage();
                return;
            }
            if (action === "leave") {
                leaveGroup();
                return;
            }
            if (action === "report") {
                toastr.info("Report noted. Admin review workflow can be connected later.");
            }
        }

        function closeCurrentConversation() {
            emitStopTyping();
            current_conversation_id = null;
            participant = null;
            currentConversation = null;
            activeParticipantUser = null;
            pagination = { loading: false, hasMore: false, nextBefore: null };
            pinnedMessages = [];
            renderPinnedMessage();
            chat_message_title_container.classList.add("invisible");
            chat_form_container.classList.add("invisible");
            user_online_status_text_container.innerHTML = "";
            chat_message_list.innerHTML = `<div class="flex gap-2 text-soft-color items-center justify-center h-full">
                    <h1 class="text-2xl font-bold">Select a conversation</h1>
                </div>`;
            renderConversationList(conversationDataset);
            toggleChatPanel(false);
        }

        async function startInboxCall(targetId, type, displayName) {
            if (callTargetId || pendingIncomingCall) {
                showCallNotice("Already in a call");
                return;
            }
            if (!onlineUsersList.includes(String(targetId))) {
                showCallNotice(`${displayName || "User"} is offline`);
                return;
            }
            callTargetId = targetId;
            callPeerName = displayName || targetId;
            inboxCallType = type;
            setInboxCallPeer(callPeerName);
            setInboxCallMode(type);
            setInboxCallStatus("Ringing...");
            showInboxCallOverlay();

            try {
                await startInboxLocalStream(type);
                callPeerConnection = createInboxPeerConnection();
                const offer = await callPeerConnection.createOffer();
                await callPeerConnection.setLocalDescription(offer);
                socketRef.emit("call-user", {
                    from: currentUserId,
                    to: targetId,
                    offer: callPeerConnection.localDescription,
                    callType: type,
                    callerName: currentUserName,
                    callerAvatar: currentUserAvatar,
                });
                startCallRingingTimeout();
            } catch (error) {
                console.warn("Call start failed", error);
                showCallNotice("Could not access camera or microphone");
                endInboxCall({ notifyPeer: false });
            }
        }

        async function acceptInboxCall() {
            if (!pendingIncomingCall) return;
            const incoming = pendingIncomingCall;
            pendingIncomingCall = null;
            clearCallRingingTimeout();
            hideIncomingCallOverlay();
            callTargetId = incoming.from;
            callPeerName = incoming.callerName || incoming.from;
            inboxCallType = incoming.callType || "video";
            setInboxCallPeer(callPeerName);
            setInboxCallMode(inboxCallType);
            setInboxCallStatus("Connecting...");
            showInboxCallOverlay();

            try {
                await startInboxLocalStream(inboxCallType);
                callPeerConnection = createInboxPeerConnection();
                await callPeerConnection.setRemoteDescription(new RTCSessionDescription(incoming.offer));
                await flushCallCandidates();
                const answer = await callPeerConnection.createAnswer();
                await callPeerConnection.setLocalDescription(answer);
                socketRef.emit("make-answer", {
                    to: incoming.from,
                    from: currentUserId,
                    answer: callPeerConnection.localDescription,
                });
            } catch (error) {
                console.warn("Call accept failed", error);
                showCallNotice("Could not access camera or microphone");
                endInboxCall({ notifyPeer: true });
            }
        }

        async function startInboxLocalStream(type) {
            if (callLocalStream) return;
            const constraints = {
                audio: { echoCancellation: true, noiseSuppression: true },
                video:
                    type === "video"
                        ? { width: { ideal: 1280 }, height: { ideal: 720 }, facingMode: "user" }
                        : false,
            };
            callLocalStream = await navigator.mediaDevices.getUserMedia(constraints);
            if (inbox_local_video) inbox_local_video.srcObject = callLocalStream;
            isCallMuted = false;
            isCallCameraOff = type !== "video";
            isRemoteAudioMuted = false;
            if (inbox_local_fallback) {
                inbox_local_fallback.textContent = getInitials(currentUserName || currentUserId);
                inbox_local_fallback.classList.toggle("hidden", type === "video");
            }
            updateInboxCallControls();
        }

        function createInboxPeerConnection() {
            const connection = new RTCPeerConnection(CALL_ICE_CONFIG);
            callRemoteStream = new MediaStream();
            if (inbox_remote_video) inbox_remote_video.srcObject = callRemoteStream;

            callLocalStream.getTracks().forEach((track) => {
                connection.addTrack(track, callLocalStream);
            });

            connection.ontrack = (event) => {
                if (event.streams && event.streams[0]) {
                    inbox_remote_video.srcObject = event.streams[0];
                } else if (event.track) {
                    callRemoteStream.addTrack(event.track);
                }
                if (event.track.kind === "video" && inboxCallType === "video") {
                    inbox_remote_fallback.classList.add("is-video-ready");
                }
            };

            connection.onicecandidate = (event) => {
                if (event.candidate && callTargetId) {
                    socketRef.emit("ice-candidate", {
                        to: callTargetId,
                        from: currentUserId,
                        candidate: event.candidate,
                    });
                }
            };

            connection.onconnectionstatechange = () => {
                if (connection.connectionState === "connected") {
                    clearCallRingingTimeout();
                    setInboxCallStatus("Connected");
                    startInboxCallTimer();
                }
                if (["disconnected", "failed", "closed"].includes(connection.connectionState)) {
                    endInboxCall({ notifyPeer: false });
                }
            };

            return connection;
        }

        async function flushCallCandidates() {
            if (!callPeerConnection || !callPeerConnection.remoteDescription || !queuedCallCandidates.length) return;
            const candidates = queuedCallCandidates;
            queuedCallCandidates = [];
            for (const candidate of candidates) {
                try {
                    await callPeerConnection.addIceCandidate(new RTCIceCandidate(candidate));
                } catch (error) {
                    console.warn("Queued ICE candidate failed", error);
                }
            }
        }

        function showIncomingCallOverlay(incoming) {
            const name = incoming.callerName || incoming.from;
            if (inbox_incoming_title) {
                inbox_incoming_title.textContent = incoming.callType === "audio" ? "Incoming audio call" : "Incoming video call";
            }
            if (inbox_incoming_subtitle) inbox_incoming_subtitle.textContent = name;
            if (inbox_incoming_avatar) inbox_incoming_avatar.textContent = getInitials(name);
            if (inbox_incoming_call) inbox_incoming_call.classList.remove("hidden");
            if (navigator.vibrate) navigator.vibrate([160, 80, 160, 80, 160]);
            startCallRingingTimeout(() => {
                if (!pendingIncomingCall) return;
                socketRef.emit("reject-call", { to: pendingIncomingCall.from, from: currentUserId });
                pendingIncomingCall = null;
                hideIncomingCallOverlay();
                showCallNotice("Missed call");
            });
        }

        function hideIncomingCallOverlay() {
            if (inbox_incoming_call) inbox_incoming_call.classList.add("hidden");
        }

        function showInboxCallOverlay() {
            if (inbox_call_overlay) inbox_call_overlay.classList.remove("hidden");
        }

        function hideInboxCallOverlay() {
            if (inbox_call_overlay) inbox_call_overlay.classList.add("hidden");
        }

        function setInboxCallPeer(name) {
            if (inbox_call_name) inbox_call_name.textContent = name || "Contact";
            if (inbox_call_avatar) inbox_call_avatar.textContent = getInitials(name);
        }

        function setInboxCallStatus(status) {
            if (inbox_call_status) inbox_call_status.textContent = status;
        }

        function setInboxCallMode(type) {
            if (inbox_call_card) inbox_call_card.dataset.callType = type;
            if (inbox_remote_fallback) {
                inbox_remote_fallback.classList.remove("is-video-ready");
                inbox_remote_fallback.classList.toggle("audio-only", type === "audio");
            }
            if (inbox_local_preview) inbox_local_preview.classList.toggle("audio-only", type === "audio");
            if (inbox_call_camera) inbox_call_camera.disabled = type !== "video";
        }

        function startCallRingingTimeout(onTimeout) {
            clearCallRingingTimeout();
            callRingingTimeout = setTimeout(() => {
                if (typeof onTimeout === "function") {
                    onTimeout();
                    return;
                }
                showCallNotice("No answer");
                endInboxCall({ notifyPeer: true });
            }, 45000);
        }

        function clearCallRingingTimeout() {
            if (callRingingTimeout) {
                clearTimeout(callRingingTimeout);
                callRingingTimeout = null;
            }
        }

        function startInboxCallTimer() {
            if (callTimerInterval) return;
            callStartedAt = Date.now();
            callTimerInterval = setInterval(() => {
                const elapsed = Math.floor((Date.now() - callStartedAt) / 1000);
                const mins = String(Math.floor(elapsed / 60)).padStart(2, "0");
                const secs = String(elapsed % 60).padStart(2, "0");
                if (inbox_call_timer) inbox_call_timer.textContent = `${mins}:${secs}`;
            }, 1000);
        }

        function stopInboxCallTimer() {
            if (callTimerInterval) {
                clearInterval(callTimerInterval);
                callTimerInterval = null;
            }
            callStartedAt = null;
            if (inbox_call_timer) inbox_call_timer.textContent = "00:00";
        }

        function updateInboxCallControls() {
            if (inbox_call_mute) {
                inbox_call_mute.classList.toggle("is-off", isCallMuted);
                const label = inbox_call_mute.querySelector("span:last-child");
                if (label) label.textContent = isCallMuted ? "Unmute" : "Mute";
            }
            if (inbox_call_camera) {
                inbox_call_camera.classList.toggle("is-off", isCallCameraOff);
                const label = inbox_call_camera.querySelector("span:last-child");
                if (label) label.textContent = isCallCameraOff ? "Camera off" : "Camera";
            }
            if (inbox_call_speaker) {
                inbox_call_speaker.classList.toggle("is-off", isRemoteAudioMuted);
                const label = inbox_call_speaker.querySelector("span:last-child");
                if (label) label.textContent = isRemoteAudioMuted ? "Speaker off" : "Speaker";
            }
        }

        function endInboxCall({ notifyPeer }) {
            const peer = callTargetId || pendingIncomingCall?.from;
            if (notifyPeer && peer) {
                socketRef.emit("end-call", { to: peer, from: currentUserId });
            }
            clearCallRingingTimeout();
            if (callPeerConnection) {
                try {
                    callPeerConnection.onconnectionstatechange = null;
                    callPeerConnection.close();
                } catch (error) {
                    console.warn("Call close failed", error);
                }
                callPeerConnection = null;
            }
            if (callLocalStream) {
                callLocalStream.getTracks().forEach((track) => track.stop());
                callLocalStream = null;
            }
            if (callRemoteStream) {
                callRemoteStream.getTracks().forEach((track) => track.stop());
                callRemoteStream = null;
            }
            if (inbox_local_video) inbox_local_video.srcObject = null;
            if (inbox_remote_video) {
                inbox_remote_video.srcObject = null;
                inbox_remote_video.muted = false;
            }
            stopInboxCallTimer();
            hideInboxCallOverlay();
            hideIncomingCallOverlay();
            callTargetId = null;
            callPeerName = "";
            pendingIncomingCall = null;
            queuedCallCandidates = [];
            isCallMuted = false;
            isCallCameraOff = false;
            isRemoteAudioMuted = false;
            updateInboxCallControls();
        }

        function showCallNotice(message) {
            if (typeof toastr !== "undefined") {
                toastr.info(message);
            } else {
                console.log(message);
            }
        }

        function getInitials(value) {
            if (!value) return "--";
            const parts = String(value).trim().split(/\s+/).filter(Boolean);
            if (parts.length > 1) return `${parts[0][0]}${parts[1][0]}`.toUpperCase();
            const cleaned = String(value).replace(/[^a-zA-Z0-9]/g, "");
            return cleaned ? cleaned.slice(0, 2).toUpperCase() : "--";
        }

        function openInlineAddMember() {
            if (!inline_add_member_panel || !inline_add_member_input) return;
            if (inline_add_member_panel.classList.contains("invisible")) {
                inline_add_member_panel.classList.remove("invisible", "w-0");
                inline_add_member_panel.classList.add("w-[95vw]", "sm:w-full", "visible", "z-10");
            }
            inline_add_member_input.value = "";
            if (inline_add_member_results) {
                inline_add_member_results.innerHTML = `<div class="inline-add-member-empty">Type to search</div>`;
            }
            inline_add_member_input.focus();
        }

        function closeInlineAddMember() {
            if (!inline_add_member_panel) return;
            inline_add_member_panel.classList.remove("w-[95vw]", "sm:w-full", "visible", "z-10");
            inline_add_member_panel.classList.add("w-0", "invisible");
            if (inline_add_member_results) inline_add_member_results.innerHTML = "";
        }

        function ensureTypingIndicator() {
            if (!chat_message_list) return null;
            const indicator = document.querySelector("#typing-indicator");
            if (indicator && !chat_message_list.contains(indicator)) {
                chat_message_list.appendChild(indicator);
            }
            return indicator;
        }

        function setConversationPreview(conversationId, text, isTyping = false) {
            const previewEl = document.querySelector(
                `.conversation-item[data-conversation-id="${conversationId}"] .conversation-preview`
            );
            if (!previewEl) return;
            previewEl.textContent = text;
            previewEl.classList.toggle("is-typing", isTyping);
        }

        function restoreConversationPreview(conversationId) {
            const previewEl = document.querySelector(
                `.conversation-item[data-conversation-id="${conversationId}"] .conversation-preview`
            );
            if (!previewEl) return;
            const original = previewEl.getAttribute("data-preview") || "";
            previewEl.textContent = original;
            previewEl.classList.remove("is-typing");
        }

        function getTypingLabel(entry) {
            if (!entry || entry.senders.size === 0) return "";
            if (!entry.isGroup) return "Typing...";
            const names = Array.from(entry.senders.values());
            if (names.length === 1) return `${names[0]} typing...`;
            return `${names[0]} +${names.length - 1} typing...`;
        }

        function updateTypingForConversation(conversationId) {
            const entry = typingByConversation.get(conversationId);
            if (!entry || entry.senders.size === 0) {
                restoreConversationPreview(conversationId);
            } else {
                setConversationPreview(conversationId, getTypingLabel(entry), true);
            }

            if (conversationId === current_conversation_id) {
                const indicator = ensureTypingIndicator();
                if (!indicator) return;
                const labelEl = indicator.querySelector(".typing-label");
                if (!entry || entry.senders.size === 0) {
                    indicator.classList.add("hidden");
                    if (typing_input_indicator) typing_input_indicator.classList.add("hidden");
                } else {
                    indicator.classList.remove("hidden");
                    if (labelEl) labelEl.textContent = getTypingLabel(entry);
                    if (typing_input_indicator) {
                        typing_input_indicator.classList.remove("hidden");
                        const inputLabel = typing_input_indicator.querySelector(".typing-label");
                        if (inputLabel) inputLabel.textContent = getTypingLabel(entry);
                    }
                }
            }
        }

        function applyTypingToList() {
            typingByConversation.forEach((_, conversationId) => {
                updateTypingForConversation(conversationId);
            });
        }

        function emitTypingStatus() {
            if (!current_conversation_id || !currentUserId) return;
            socketRef.emit("typing", {
                conversationId: current_conversation_id,
                senderId: currentUserId,
                senderName: currentUserName,
            });
            clearTimeout(typingTimeout);
            typingTimeout = setTimeout(() => {
                socketRef.emit("stop-typing", {
                    conversationId: current_conversation_id,
                    senderId: currentUserId,
                    senderName: currentUserName,
                });
            }, 1200);
        }

        function emitStopTyping() {
            if (!current_conversation_id || !currentUserId) return;
            socketRef.emit("stop-typing", {
                conversationId: current_conversation_id,
                senderId: currentUserId,
                senderName: currentUserName,
            });
        }

        function getCurrentMemberIds() {
            if (participant?.isGroup && Array.isArray(participant.members)) {
                return participant.members.map((member) => String(member.id));
            }
            const ids = [];
            if (participant?.id) ids.push(String(participant.id));
            if (currentUserId) ids.push(String(currentUserId));
            return ids;
        }

        async function addMemberToConversation(memberId) {
            if (!current_conversation_id || !memberId) return;
            const response = await fetch(`/inbox/conversation/group/${current_conversation_id}/add`, {
                method: "POST",
                body: JSON.stringify({ memberIds: [memberId] }),
                headers: { "content-type": "application/json; charset=UTF-8" },
            });
            const result = await response.json();
            if (!result.errors) {
                toastr.success(result.message || "Member added.");
                setTimeout(() => location.reload(), 100);
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        async function searchInlineMembers(query) {
            if (!inline_add_member_results) return;
            const response = await fetch("/inbox/search", {
                method: "POST",
                body: JSON.stringify({ user: query }),
                headers: { "content-type": "application/json; charset=UTF-8" },
            });
            const result = await response.json();
            if (result.errors) {
                inline_add_member_results.innerHTML = `<div class="inline-add-member-empty">${result.errors.common.msg}</div>`;
                return;
            }
            const existingIds = new Set(getCurrentMemberIds());
            if (!Array.isArray(result) || result.length === 0) {
                inline_add_member_results.innerHTML = `<div class="inline-add-member-empty">No user found</div>`;
                return;
            }
            inline_add_member_results.innerHTML = result
                .map((user) => {
                    const isExisting = existingIds.has(String(user._id));
                    const avatar = user.avatar
                        ? `<img src="./uploads/avatars/${user.avatar}" alt="${escapeHtml(user.name)}">`
                        : `<div class="inline-add-member-avatar">${escapeHtml(user.name[0] || "?").toUpperCase()}</div>`;
                    return `<div class="inline-add-member-row ${isExisting ? "is-disabled" : ""}" ${isExisting ? "" : `data-user-id="${user._id}"`}>
                                ${avatar}
                                <div class="inline-add-member-name">
                                    <div>${escapeHtml(user.name)}</div>
                                    ${isExisting ? `<span>Already in conversation</span>` : ""}
                                </div>
                            </div>`;
                })
                .join("");
        }

        if (inline_add_member_input) {
            inline_add_member_input.addEventListener("keyup", () => {
                const query = inline_add_member_input.value.trim();
                clearTimeout(inlineMemberTimer);
                if (!query) {
                    if (inline_add_member_results) {
                        inline_add_member_results.innerHTML = `<div class="inline-add-member-empty">Type to search</div>`;
                    }
                    return;
                }
                inlineMemberTimer = setTimeout(() => searchInlineMembers(query), 400);
            });
        }

        if (inline_add_member_close) {
            inline_add_member_close.addEventListener("click", () => closeInlineAddMember());
        }

        if (inline_add_member_results) {
            inline_add_member_results.addEventListener("click", (event) => {
                const row = event.target.closest(".inline-add-member-row");
                if (!row || row.classList.contains("is-disabled")) return;
                const userId = row.getAttribute("data-user-id");
                if (userId) {
                    addMemberToConversation(userId);
                }
            });
        }

        function escapeHtml(text) {
            return String(text || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/\"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function escapeRegex(text) {
            return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        }

        function renderPinnedMessage() {
            if (!pinned_message_container) return;
            if (!pinnedMessages.length) {
                pinned_message_container.classList.add("hidden");
                pinned_message_container.innerHTML = "";
                chat_message_list?.classList.remove("has-pinned");
                return;
            }

            if (activePinnedIndex >= pinnedMessages.length) activePinnedIndex = 0;
            const pinnedMessage = pinnedMessages[activePinnedIndex] || pinnedMessages[0];
            const pinnedText = pinnedMessage.text || "Attachment";
            const attachmentCount = pinnedMessage.attachments?.length || 0;
            const attachmentLabel = attachmentCount ? `${attachmentCount} attachment${attachmentCount > 1 ? "s" : ""}` : "";
            const senderName = pinnedMessage.sender?.name ? `${pinnedMessage.sender.name}: ` : "";
            const expiresLabel = formatPinExpiry(pinnedMessage.expiresAt);
            const countLabel = pinnedMessages.length > 1 ? ` ${activePinnedIndex + 1} of ${pinnedMessages.length}` : "";
            pinned_message_container.innerHTML = `
                <div class="pinned-item" data-message-id="${pinnedMessage.id}">
                    <button class="pinned-content" type="button">
                        <span class="pinned-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652l-9.193 9.193a4.5 4.5 0 0 1-1.897 1.13L6 16.875l1.102-4.111a4.5 4.5 0 0 1 1.13-1.897l8.63-8.63ZM19.5 7.125 16.875 4.5M18 14v4.75A2.25 2.25 0 0 1 15.75 21h-10.5A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                        </span>
                        <span class="pinned-copy">
                            <span class="pinned-label">Pinned message${countLabel}</span>
                            <span class="pinned-text">${escapeHtml(senderName)}${escapeHtml(pinnedText)}</span>
                            ${attachmentLabel || expiresLabel ? `<span class="pinned-meta">${escapeHtml([attachmentLabel, expiresLabel].filter(Boolean).join(" - "))}</span>` : ""}
                        </span>
                    </button>
                    <button class="pinned-remove-btn" type="button" data-message-id="${pinnedMessage.id}" aria-label="Unpin message">×</button>
                </div>
            `;
            pinned_message_container.classList.remove("hidden");
            chat_message_list?.classList.add("has-pinned");
        }

        function jumpToPinnedMessage(messageId) {
            if (!messageId || !chat_message_list) return;
            const row = chat_message_list.querySelector(`.message-row[data-message-id="${messageId}"]`);
            if (!row) {
                toastr.info("Pinned message isn't loaded. Scroll up to load older messages.");
                return;
            }
            pinned_message_container?.querySelector(".pinned-detail")?.remove();
            focusMessageRow(row);
        }

        let messageFocusTimer = null;
        function focusMessageRow(row) {
            if (!row) return;
            document.querySelectorAll(".message-row.message-focus").forEach((item) => {
                item.classList.remove("message-focus");
            });
            window.clearTimeout(messageFocusTimer);

            row.scrollIntoView({ behavior: "smooth", block: "center" });

            const applyFocus = () => {
                row.classList.remove("message-focus");
                void row.offsetWidth;
                row.classList.add("message-focus");
                messageFocusTimer = window.setTimeout(() => {
                    row.classList.remove("message-focus");
                }, 2200);
            };

            applyFocus();
            window.setTimeout(applyFocus, 450);
        }

        function askPinDuration() {
            return new Promise((resolve) => {
                document.querySelector(".pin-duration-overlay")?.remove();
                const overlay = document.createElement("div");
                overlay.className = "pin-duration-overlay";
                overlay.innerHTML = `
                    <div class="pin-duration-dialog" role="dialog" aria-modal="true">
                        <div class="pin-duration-title">Pin message</div>
                        <div class="pin-duration-subtitle">Choose how long your pin lasts</div>
                        <button class="pin-duration-option" type="button" data-duration="24h">24 hours</button>
                        <button class="pin-duration-option" type="button" data-duration="7d">7 days</button>
                        <button class="pin-duration-option" type="button" data-duration="30d">30 days</button>
                        <button class="pin-duration-cancel" type="button" data-duration="">Cancel</button>
                    </div>`;
                document.body.appendChild(overlay);

                const cleanup = (value) => {
                    document.removeEventListener("keydown", onKey);
                    overlay.remove();
                    resolve(value);
                };
                const onKey = (event) => {
                    if (event.key === "Escape") cleanup(null);
                };
                document.addEventListener("keydown", onKey);
                overlay.addEventListener("click", (event) => {
                    if (event.target === overlay) return cleanup(null);
                    const btn = event.target.closest("[data-duration]");
                    if (!btn) return;
                    cleanup(btn.dataset.duration || null);
                });
            });
        }

        function normalizePinnedMessage(message) {
            if (!message) return null;
            return {
                id: message._id || message.id || message.message_id || "",
                text: message.text || "",
                attachments: message.attachments || [],
                sender: message.sender || null,
                createdAt: message.createdAt || message.date_time || null,
                expiresAt: message.expiresAt || null,
            };
        }

        function normalizePinnedMessages(messages) {
            if (!Array.isArray(messages)) return [];
            return messages.map(normalizePinnedMessage).filter((message) => message?.id).slice(0, 3);
        }

        function formatPinExpiry(expiresAt) {
            if (!expiresAt) return "";
            const expiry = moment(expiresAt);
            if (!expiry.isValid()) return "";
            return `expires ${expiry.fromNow()}`;
        }

        async function setPinnedMessage(message, duration) {
            if (pinnedMessages.some((item) => item.id === message?.id)) {
                await unpinPinnedMessage(message.id);
                return;
            }
            if (!current_conversation_id || !message?.id) return;
            const response = await fetch(`/inbox/message/${current_conversation_id}/pin`, {
                method: "POST",
                body: JSON.stringify({ message_id: message.id, duration }),
                headers: { "content-type": "application/json; charset=UTF-8" },
            });
            const result = await response.json();
            if (!result.errors) {
                pinnedMessages = normalizePinnedMessages(result.data?.pinnedMessages || []);
                if (!pinnedMessages.length) {
                    const pinned = normalizePinnedMessage(result.data?.pinnedMessage) || message;
                    pinnedMessages = [
                        pinned,
                        ...pinnedMessages.filter((item) => item.id !== pinned.id),
                    ].slice(0, 3);
                }
                activePinnedIndex = 0;
                renderPinnedMessage();
                toastr.success(result.message || "Message pinned.");
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        async function unpinPinnedMessage(messageId = null) {
            if (!current_conversation_id) return;
            const query = messageId ? `?message_id=${encodeURIComponent(messageId)}` : "";
            const response = await fetch(`/inbox/message/${current_conversation_id}/pin${query}`, {
                method: "DELETE",
            });
            const result = await response.json();
            if (!result.errors) {
                pinnedMessages = messageId
                    ? pinnedMessages.filter((message) => message.id !== messageId)
                    : [];
                activePinnedIndex = 0;
                renderPinnedMessage();
                toastr.success(result.message || "Message unpinned.");
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        function showPinnedMessageDetails(messageId) {
            const message = pinnedMessages.find((item) => item.id === messageId);
            if (!message || !pinned_message_container) return;
            const existing = pinned_message_container.querySelector(".pinned-detail");
            if (existing && existing.dataset.messageId === messageId) {
                existing.remove();
                return;
            }
            if (existing) existing.remove();
            const attachmentNames = (message.attachments || []).length
                ? `<div class="pinned-detail-files">${message.attachments.map((item) => `<span>${escapeHtml(getReadableFileName(item))}</span>`).join("")}</div>`
                : "";
            pinned_message_container.insertAdjacentHTML(
                "beforeend",
                `<div class="pinned-detail" data-message-id="${message.id}">
                    <div class="pinned-detail-title">Message details</div>
                    <div class="pinned-detail-row"><span>Sender</span><strong>${escapeHtml(message.sender?.name || "Unknown")}</strong></div>
                    <div class="pinned-detail-row"><span>Time</span><strong>${message.createdAt ? moment(message.createdAt).format("lll") : "Unknown"}</strong></div>
                    <div class="pinned-detail-text">${escapeHtml(message.text || "Attachment")}</div>
                    ${attachmentNames}
                </div>`
            );
            const row = chat_message_list?.querySelector(`.message-row[data-message-id="${message.id}"]`);
            if (row) {
                focusMessageRow(row);
            }
        }

        function closeMessageMenus() {
            document.querySelectorAll(".message-menu.active").forEach((menu) => {
                menu.classList.remove("active");
            });
        }

        function getMessageData(row) {
            if (!row) return null;
            const attachments = row.dataset.messageAttachments
                ? JSON.parse(decodeURIComponent(row.dataset.messageAttachments))
                : [];
            return {
                id: row.dataset.messageId,
                text: row.dataset.messageText || "",
                attachments,
            };
        }

        async function copyToClipboard(text) {
            if (!text) return false;
            if (navigator.clipboard?.writeText) {
                await navigator.clipboard.writeText(text);
                return true;
            }
            const textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.setAttribute("readonly", "");
            textarea.style.position = "absolute";
            textarea.style.left = "-9999px";
            document.body.appendChild(textarea);
            textarea.select();
            const success = document.execCommand("copy");
            document.body.removeChild(textarea);
            return success;
        }

        function syncAttachmentInput() {
            if (!attachment_input) return;
            const dataTransfer = new DataTransfer();
            attachmentFiles.forEach((file) => dataTransfer.items.add(file));
            attachment_input.files = dataTransfer.files;
        }

        function getFileKind(fileNameOrType) {
            const value = String(fileNameOrType || "").toLowerCase();
            if (value.startsWith("image/") || /\.(jpg|jpeg|png|webp|gif)$/i.test(value)) return "image";
            if (value.startsWith("video/") || /\.(mp4|webm|mov|m4v)$/i.test(value)) return "video";
            if (value.startsWith("audio/") || /\.(mp3|wav|webm|ogg|m4a|aac)$/i.test(value)) return "audio";
            if (/\.(pdf)$/i.test(value)) return "pdf";
            return "doc";
        }

        function getReadableFileName(fileName) {
            return decodeURIComponent(String(fileName || "Attachment").split("/").pop());
        }

        function renderAttachmentPreviewItem(file, index) {
            const url = URL.createObjectURL(file);
            const kind = getFileKind(file.type || file.name);
            const safeName = escapeHtml(file.name);
            const removeBtn = `<button class="attachment-remove-btn" type="button" data-index="${index}" aria-label="Remove attachment">×</button>`;
            if (kind === "image") {
                return `<div class="attachment-thumb" data-kind="image">
                            <img src="${url}" alt="${safeName}" onload="URL.revokeObjectURL('${url}')">
                            <div class="attachment-name">${safeName}</div>
                            ${removeBtn}
                        </div>`;
            }
            if (kind === "video") {
                return `<div class="attachment-thumb" data-kind="video">
                            <video src="${url}" muted playsinline></video>
                            <div class="attachment-name">${safeName}</div>
                            ${removeBtn}
                        </div>`;
            }
            if (kind === "audio") {
                return `<div class="attachment-thumb attachment-file-thumb" data-kind="audio">
                            <audio src="${url}" controls></audio>
                            <div class="attachment-name">${safeName}</div>
                            ${removeBtn}
                        </div>`;
            }
            return `<div class="attachment-thumb attachment-file-thumb" data-kind="${kind}">
                        <div class="attachment-file-icon">${kind === "pdf" ? "PDF" : "DOC"}</div>
                        <div class="attachment-name">${safeName}</div>
                        ${removeBtn}
                    </div>`;
        }

        function renderAttachmentPreview() {
            if (!attachment_preview) return;
            if (!attachmentFiles.length) {
                attachment_preview.innerHTML = "";
                attachment_preview.classList.add("hidden");
                return;
            }
            const previews = attachmentFiles
                .map((file, index) => renderAttachmentPreviewItem(file, index))
                .join("");
            attachment_preview.innerHTML = previews;
            attachment_preview.classList.remove("hidden");
        }

        function getConversationDisplay(conversation) {
            if (!conversation) return null;
            if (conversation.isGroup) {
                const members = conversation.members || [];
                return {
                    id: conversation._id,
                    isGroup: true,
                    name: conversation.name || "Group",
                    avatar: conversation.avatar || null,
                    memberCount: members.length,
                };
            }
            const isCreator = String(conversation.creator?.id) === String(currentUserId);
            const other = isCreator ? conversation.participant : conversation.creator;
            if (!other) return null;
            return {
                id: conversation._id,
                isGroup: false,
                name: other.name,
                avatar: other.avatar || null,
                participantId: other.id,
            };
        }

        function renderConversationList(list, searchQuery = "") {
            if (!conversation_content_wrapper) return;
            if (!list || list.length === 0) {
                const isSearching = !!searchQuery;
                conversation_content_wrapper.innerHTML = `<div class="flex flex-col items-center gap-3 justify-center text-center p-2 sm:px-3 py-2 h-full text-soft-color hover-bg-light-color cursor-pointer">
                        <div>
                            <img src="./images/no-conversation.png" alt="" class="w-32">
                        </div>
                        <div>
                            <h3 class="text-md font-bold">${isSearching ? "No chats found" : "No conversation yet"}</h3>
                            <p>${isSearching ? "Try another name or message." : "Create conversation to contact others"}</p>
                        </div>
                    </div>`;
                return;
            }

            const html = list
                .map((conversation) => {
                    const display = getConversationDisplay(conversation);
                    if (!display) return "";
                    const previewText = conversation.message?.content || (display.isGroup ? "Group created." : "You are joining this conversation.");
                    const trimmed = previewText.length > 40 ? `${previewText.slice(0, 40)}...` : previewText;
                    const isActive = String(current_conversation_id) === String(conversation._id);
                    const initials = display.name ? display.name[0].toUpperCase() : "?";
                    const avatarHtml = display.avatar
                        ? `<img src="./uploads/avatars/${display.avatar}" alt="${escapeHtml(display.name)}" class="w-12 h-12 rounded-full">`
                        : `<div class="bg-light-color hover-bg-dark-color flex items-center justify-center text-neutral-content rounded-full w-12 h-12">
                                <span class="text-2xl">${escapeHtml(initials)}</span>
                           </div>`;
                    const badgeHtml = display.isGroup
                        ? `<span class="group-count-badge" title="Members">${display.memberCount}</span>`
                        : `<span class="user-status-badge absolute bottom-0 right-0 inline-block w-3 h-3 bg-gray-400 border-2 border-current rounded-full" data-user-id="${display.participantId}"></span>`;
                    return `
                    <div class="conversation-item ${isActive ? "active" : ""}" data-conversation-id="${conversation._id}" data-is-group="${display.isGroup}" data-participant-id="${display.participantId || ""}" data-participant-name="${escapeHtml(display.name)}" data-participant-avatar="${display.avatar || ""}" data-member-count="${display.memberCount || 0}">
                        <div class="conversation-avatar">
                            ${avatarHtml}
                            ${badgeHtml}
                        </div>
                        <div class="conversation-meta">
                            <div class="conversation-top">
                                <h3 class="conversation-name">${escapeHtml(display.name)}</h3>
                                <div class="conversation-time">${moment(conversation.message?.date_time || conversation.updatedAt).fromNow(true)}</div>
                            </div>
                            <div class="conversation-preview" data-preview="${escapeHtml(trimmed)}">${escapeHtml(trimmed)}</div>
                            ${display.isGroup ? `<div class="conversation-sub">${display.memberCount} members</div>` : ""}
                        </div>
                        <div class="conversation-actions">
                            <button type="button" class="conversation-menu-btn" aria-label="Conversation options">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
                                </svg>
                            </button>
                            <div class="conversation-row-menu dropdown">
                                <button type="button" class="conversation-row-menu-item" data-row-action="open">Open chat</button>
                                <button type="button" class="conversation-row-menu-item" data-row-action="mute">Mute notifications</button>
                                <button type="button" class="conversation-row-menu-item danger" data-row-action="delete">Delete chat</button>
                            </div>
                        </div>
                    </div>`;
                })
                .join("");

            conversation_content_wrapper.innerHTML = html;
            updateConversationStatusBadges();
            applyTypingToList();
        }

        function updateConversationStatusBadges() {
            const badges = document.querySelectorAll(".user-status-badge");
            badges.forEach((badge) => {
                const userId = badge.dataset.userId;
                if (!userId) return;
                const isOnline = onlineUsersList.includes(userId);
                badge.classList.toggle("is-online", isOnline);
                badge.classList.toggle("is-offline", !isOnline);
            });
        }

        renderConversationList(conversationDataset);

        conversation_content_wrapper?.addEventListener("click", (event) => {
            const menuBtn = event.target.closest(".conversation-menu-btn");
            if (menuBtn) {
                event.stopPropagation();
                const menu = menuBtn.parentElement?.querySelector(".conversation-row-menu");
                const isActive = menu?.classList.contains("active");
                closeConversationRowMenus();
                if (!isActive && menu) menu.classList.add("active");
                return;
            }

            const rowAction = event.target.closest(".conversation-row-menu-item");
            if (rowAction) {
                event.stopPropagation();
                const item = rowAction.closest(".conversation-item");
                const action = rowAction.dataset.rowAction;
                handleConversationRowAction(action, item);
                closeConversationRowMenus();
                return;
            }

            const item = event.target.closest(".conversation-item");
            if (!item) return;
            openConversationFromItem(item);
        });

        function openConversationFromItem(item) {
            const conversationId = item.dataset.conversationId;
            const isGroup = item.dataset.isGroup === "true";
            const participantId = item.dataset.participantId || null;
            const participantName = item.dataset.participantName;
            const participantAvatar = item.dataset.participantAvatar || null;
            const memberCount = parseInt(item.dataset.memberCount || "0", 10);
            openConversation(conversationId, {
                isGroup,
                participantId,
                name: participantName,
                avatar: participantAvatar,
                memberCount,
            });
        }

        function closeConversationRowMenus() {
            document.querySelectorAll(".conversation-row-menu.active").forEach((menu) => {
                menu.classList.remove("active");
            });
        }

        function handleConversationRowAction(action, item) {
            if (!item || !action) return;
            if (action === "open") {
                openConversationFromItem(item);
                return;
            }
            if (action === "mute") {
                const conversationId = item.dataset.conversationId;
                const key = `muted-conversation-${conversationId}`;
                const muted = localStorage.getItem(key) === "1";
                localStorage.setItem(key, muted ? "0" : "1");
                toastr.success(muted ? "Notifications unmuted." : "Notifications muted.");
                return;
            }
            if (action === "delete") {
                openConversationFromItem(item);
                deleteMeassage();
            }
        }

        function filterConversationDataset() {
            const query = conversation_search_input ? conversation_search_input.value.trim().toLowerCase() : "";
            const filtered = (conversationDataset || []).filter((item) => {
                if (query === "") return true;
                const preview = item.message?.content || "";
                if (item.isGroup && item.name) {
                    return item.name.toLowerCase().includes(query) || preview.toLowerCase().includes(query);
                }
                return (
                    item.creator?.name?.toLowerCase().includes(query) ||
                    item.participant?.name?.toLowerCase().includes(query) ||
                    item.creator?.mobile?.toLowerCase?.().includes(query) ||
                    item.participant?.mobile?.toLowerCase?.().includes(query) ||
                    preview.toLowerCase().includes(query)
                );
            });
            renderConversationList(filtered, query);
        }

        if (conversation_search_input) {
            conversation_search_input.addEventListener("input", () => {
                clearTimeout(conversationSearchTimer);
                conversationSearchTimer = setTimeout(filterConversationDataset, 120);
            });
        }

        function updateOnlineStatusText() {
            if (!participant) return;
            if (participant.isGroup) {
                const count = participant.members ? participant.members.length : currentConversation?.memberCount || 0;
                user_online_status_text_container.innerHTML = `<span class="chat-presence is-group">${count} members</span>`;
                return;
            }
            const status = getPresenceLabel(participant.id);
            user_online_status_text_container.innerHTML = `<span class="chat-presence ${status.online ? "is-online" : "is-offline"} user-online-status-text user-online-status-text${participant.id}" data-user-id="${participant.id}">
                    <span class="presence-dot"></span>${status.label}
                </span>`;
        }

        function getPresenceLabel(userId) {
            const id = String(userId || "");
            const presence = userPresence.get(id);
            const isOnline = onlineUsersList.includes(id) || presence?.onlineStatus === "Online";
            if (isOnline) return { online: true, label: "Online" };
            const lastSeen = presence?.lastSeen || activeParticipantUser?.lastSeen;
            if (lastSeen) {
                return { online: false, label: `last seen ${moment(lastSeen).fromNow()}` };
            }
            return { online: false, label: "Offline" };
        }

        function updateConversationMenu() {
            if (!participant) return;
            if (participant.isGroup) {
                if (leave_group_item) leave_group_item.style.display = "flex";
                if (add_members_icon) add_members_icon.classList.remove("hidden");
                if (chat_message_block_container) chat_message_block_container.innerHTML = "";
                if (blocked_message_form_container) blocked_message_form_container.classList.add("hidden");
                if (chat_form_container) chat_form_container.classList.remove("hidden");
                if (clear_message_item) {
                    const isAdmin = (participant.admins || []).some((id) => String(id) === String(currentUserId));
                    clear_message_item.style.display = isAdmin ? "flex" : "none";
                    if (chat_message_title_name) {
                        chat_message_title_name.classList.toggle("chat-title-editable", isAdmin);
                    }
                }
            } else {
                if (leave_group_item) leave_group_item.style.display = "none";
                if (add_members_icon) add_members_icon.classList.remove("hidden");
                if (clear_message_item) clear_message_item.style.display = "flex";
                if (chat_message_title_name) {
                    chat_message_title_name.classList.remove("chat-title-editable");
                }
            }
        }

        function renderMessage(message) {
            const isOwn = String(message.sender.id) === String(currentUserId);
            const avatar = message.sender.avatar
                ? `<img src="./uploads/avatars/${message.sender.avatar}" alt="${escapeHtml(message.sender.name)}" class="w-8 h-8 rounded-full">`
                : `<div class="bg-light-color hover-bg-dark-color flex items-center justify-center text-neutral-content rounded-full w-8 h-8">
                        <span class="text-xl">${escapeHtml(message.sender.name[0]).toUpperCase()}</span>
                   </div>`;

            const attachments = (message.attachments || [])
                .map((attachment) => renderMessageAttachment(attachment))
                .join("");

            const attachmentGrid = attachments
                ? `<div class="attachments grid gap-2 mt-2 bg-light-color/50 p-2 rounded-md">
                        ${attachments}
                   </div>`
                : "";

            const rawText = String(message.text || "");
            const messageText = escapeHtml(rawText);
            const messageId = message._id || message.message_id || "";
            const time = moment(message.createdAt || message.date_time).fromNow();
            const showSender = participant?.isGroup && !isOwn;
            const attachmentsEncoded = encodeURIComponent(JSON.stringify(message.attachments || []));

            return `
                <div class="message-row ${isOwn ? "is-own" : ""}" data-message-id="${messageId}" data-message-text="${escapeHtml(rawText)}" data-message-attachments="${attachmentsEncoded}">
                    ${isOwn ? "" : avatar}
                    <div class="message-bubble">
                        ${showSender ? `<div class="message-sender">${escapeHtml(message.sender.name)}</div>` : ""}
                        ${messageText ? `<div class="message-text" data-raw="${messageText}">${messageText}</div>` : ""}
                        ${attachmentGrid}
                        <div class="message-meta">
                            <span>${time}</span>
                            <div class="message-actions">
                                <button class="message-menu-btn" type="button" data-message-id="${messageId}" aria-label="Message options">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
                                    </svg>
                                </button>
                                <div class="message-menu dropdown" data-message-id="${messageId}">
                                    <button class="message-menu-item" data-action="copy" type="button">Copy</button>
                                    ${isOwn ? `<button class="message-menu-item" data-action="delete" type="button">Delete</button>` : ""}
                                    <button class="message-menu-item" data-action="pin" type="button">Pin</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>`;
        }

        function renderMessageAttachment(attachment) {
            const fileName = getReadableFileName(attachment);
            const safeName = escapeHtml(fileName);
            const src = `/uploads/attachments/${encodeURIComponent(attachment)}`;
            const kind = getFileKind(fileName);
            if (kind === "image") {
                return `<button type="button" class="attachment-open" data-src="${src}" data-kind="image" aria-label="Open image">
                            <img src="${src}" alt="${safeName}" class="rounded-md h-40 w-full object-cover">
                        </button>`;
            }
            if (kind === "video") {
                return `<video src="${src}" class="message-video" controls playsinline></video>`;
            }
            if (kind === "audio") {
                return `<div class="message-audio">
                            <audio src="${src}" controls></audio>
                            <a href="${src}" download="${safeName}">${safeName}</a>
                        </div>`;
            }
            return `<a href="${src}" download="${safeName}" target="_blank" class="message-document">
                        <span class="message-document-icon">${kind === "pdf" ? "PDF" : "DOC"}</span>
                        <span>${safeName}</span>
                    </a>`;
        }

        async function loadMessages(reset = false) {
            if (!current_conversation_id || pagination.loading) return;
            if (!reset && !pagination.hasMore) return;

            pagination.loading = true;
            const beforeParam = reset || !pagination.nextBefore ? "" : `&before=${encodeURIComponent(pagination.nextBefore)}`;
            const response = await fetch(`/inbox/message/${current_conversation_id}?limit=20${beforeParam}`);
            const result = await response.json();

            if (!result.errors && result.data) {
                if (reset) {
                    chat_message_list.innerHTML = "";
                }

                const messages = result.data.messages || [];
                const html = messages.map(renderMessage).join("");

                if (messages.length === 0 && reset) {
                    chat_message_list.innerHTML = `<div class="message-row message-nothing flex gap-2 text-soft-color items-center justify-center h-full">
                                <h1 class="text-2xl font-bold">You don't have message</h1>
                            </div>`;
                } else if (reset) {
                    chat_message_list.insertAdjacentHTML("beforeend", html);
                } else {
                    const prevScrollHeight = chat_message_list.scrollHeight;
                    const prevScrollTop = chat_message_list.scrollTop;
                    chat_message_list.insertAdjacentHTML("afterbegin", html);
                    chat_message_list.scrollTop = chat_message_list.scrollHeight - prevScrollHeight + prevScrollTop;
                }

                ensureTypingIndicator();

                pagination.hasMore = result.pagination?.hasMore || false;
                pagination.nextBefore = result.pagination?.nextBefore || null;

                participant = result.data.participant;
                currentConversation = participant;
                activeParticipantUser = result.participantUser || null;
                if (activeParticipantUser?._id) {
                    userPresence.set(String(activeParticipantUser._id), {
                        onlineStatus: activeParticipantUser.onlineStatus || "Offline",
                        lastSeen: activeParticipantUser.lastSeen || null,
                    });
                }
                updateOnlineStatusText();
                updateBlockUnblockUi(currentUserId, result.participantUser?.blockable);
                updateConversationMenu();
                pinnedMessages = normalizePinnedMessages(result.data.pinnedMessages || (result.data.pinnedMessage ? [result.data.pinnedMessage] : []));
                renderPinnedMessage();

                if (reset) {
                    chat_message_title_container.classList.remove("invisible");
                    chat_form_container.classList.remove("invisible");
                    chat_message_title_name.textContent = participant.name;
                    chat_message_avatar_container.innerHTML = participant.avatar
                        ? `<img src="./uploads/avatars/${participant.avatar}" alt="${escapeHtml(participant.name)}" class="w-10 h-10 rounded-full">`
                        : `<div class="bg-dark-color flex items-center justify-center text-neutral-content rounded-full w-10 h-10">
                                <span class="text-3xl">${escapeHtml(participant.name[0]).toUpperCase()}</span>
                           </div>`;
                    toggleChatPanel(true);
                    chat_message_list.scrollTop = chat_message_list.scrollHeight;
                }
            } else if (result.errors?.common?.msg) {
                toastr.warning(result.errors.common.msg);
            }
            pagination.loading = false;
        }

        function openConversation(conversationId, meta) {
            current_conversation_id = conversationId;
            currentConversation = meta;
            pinnedMessages = [];
            renderPinnedMessage();
            participant = {
                id: meta.participantId,
                name: meta.name,
                avatar: meta.avatar || null,
                isGroup: meta.isGroup,
                memberCount: meta.memberCount || 0,
            };
            pagination = { loading: false, hasMore: true, nextBefore: null };
            renderConversationList(conversationDataset);
            loadMessages(true);
            updateTypingForConversation(conversationId);
        }

        chat_message_list?.addEventListener("scroll", () => {
            if (chat_message_list.scrollTop <= 40) {
                loadMessages(false);
            }
        });

        if (chat_message_title_name) {
            chat_message_title_name.addEventListener("click", () => {
                if (!participant?.isGroup) return;
                const isAdmin = (participant.admins || []).some((id) => String(id) === String(currentUserId));
                if (!isAdmin) {
                    toastr.warning("Only admins can rename group.");
                    return;
                }
                const currentName = participant.name || "";
                const input = document.createElement("input");
                input.type = "text";
                input.value = currentName;
                input.className = "group-title-input";
                chat_message_title_name.replaceWith(input);
                input.focus();
                input.select();

                const save = async () => {
                    const nextName = input.value.trim();
                    if (!nextName || nextName === currentName) {
                        input.replaceWith(chat_message_title_name);
                        chat_message_title_name.textContent = currentName;
                        return;
                    }
                    const response = await fetch(`/inbox/conversation/group/${current_conversation_id}/name`, {
                        method: "PATCH",
                        body: JSON.stringify({ name: nextName }),
                        headers: { "content-type": "application/json; charset=UTF-8" },
                    });
                    const result = await response.json();
                    if (!result.errors) {
                        participant.name = nextName;
                        chat_message_title_name.textContent = nextName;
                        toastr.success(result.message || "Group name updated.");
                    } else {
                        toastr.error(result.errors.common.msg);
                    }
                    input.replaceWith(chat_message_title_name);
                };

                input.addEventListener("blur", save);
                input.addEventListener("keydown", (event) => {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        save();
                    }
                });
            });
        }

        socketRef.on("new_message", (data) => {
            const conversationId = data.message.conversation_id;
            if (conversationId === current_conversation_id) {
                const html = renderMessage({
                    _id: data.message.message_id,
                    text: data.message.message,
                    attachments: data.message.attachments || [],
                    sender: data.message.sender,
                    createdAt: data.message.date_time,
                });
                const wasNearBottom =
                    chat_message_list.scrollTop + chat_message_list.clientHeight >=
                    chat_message_list.scrollHeight - 50;
                chat_message_list.insertAdjacentHTML("beforeend", html);
                if (wasNearBottom) {
                    chat_message_list.scrollTop = chat_message_list.scrollHeight;
                }
            }
            const previewEl = document.querySelector(`.conversation-item[data-conversation-id="${conversationId}"] .conversation-preview`);
            const timeEl = document.querySelector(`.conversation-item[data-conversation-id="${conversationId}"] .conversation-time`);
            if (previewEl) {
                const previewText = data.message.message || "Attachment";
                previewEl.textContent = previewText;
                previewEl.setAttribute("data-preview", previewText);
                previewEl.classList.remove("is-typing");
            }
            if (timeEl) timeEl.textContent = moment(data.message.date_time).fromNow(true);
            if (typingByConversation.has(conversationId)) {
                const entry = typingByConversation.get(conversationId);
                entry.senders.delete(String(data.message.sender.id));
                if (entry.senders.size === 0) {
                    typingByConversation.delete(conversationId);
                } else {
                    typingByConversation.set(conversationId, entry);
                }
                updateTypingForConversation(conversationId);
            }
        });

        socketRef.on("incoming-call", (payload) => {
            const { from, offer, callType, callerName, callerAvatar } = payload || {};
            if (!from || !offer) return;
            if (callTargetId || pendingIncomingCall) {
                socketRef.emit("call-busy", { to: from, from: currentUserId });
                return;
            }
            pendingIncomingCall = {
                from,
                offer,
                callType: callType || "video",
                callerName: callerName || from,
                callerAvatar: callerAvatar || "",
            };
            showIncomingCallOverlay(pendingIncomingCall);
        });

        socketRef.on("call-accepted", async ({ answer }) => {
            if (!callPeerConnection || !answer) return;
            try {
                await callPeerConnection.setRemoteDescription(new RTCSessionDescription(answer));
                await flushCallCandidates();
                clearCallRingingTimeout();
                setInboxCallStatus("Connecting...");
            } catch (error) {
                console.warn("Call answer failed", error);
                showCallNotice("Call connection failed");
                endInboxCall({ notifyPeer: true });
            }
        });

        socketRef.on("ice-candidate", async ({ candidate }) => {
            if (!candidate) return;
            if (!callPeerConnection || !callPeerConnection.remoteDescription) {
                queuedCallCandidates.push(candidate);
                return;
            }
            try {
                await callPeerConnection.addIceCandidate(new RTCIceCandidate(candidate));
            } catch (error) {
                console.warn("ICE candidate failed", error);
            }
        });

        socketRef.on("call-ended", () => {
            showCallNotice("Call ended");
            endInboxCall({ notifyPeer: false });
        });

        socketRef.on("call-rejected", () => {
            showCallNotice("Call declined");
            endInboxCall({ notifyPeer: false });
        });

        socketRef.on("call-busy", () => {
            showCallNotice("User is on another call");
            endInboxCall({ notifyPeer: false });
        });

        const chat_send_message_form = document.querySelector("#chat-send-message-form");
        chat_send_message_form?.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!current_conversation_id || !participant) return;
            if (mediaRecorder && mediaRecorder.state === "recording") {
                toastr.info("Stop recording before sending.");
                return;
            }
            emitStopTyping();

            const formData = new FormData(chat_send_message_form);
            formData.append("conversation_id", current_conversation_id);
            if (!participant.isGroup) {
                formData.append("receiver_id", participant.id);
                formData.append("receiver_name", participant.name);
                formData.append("receiver_avatar", participant.avatar || null);
            }

            const response = await fetch("/inbox/message", {
                method: "POST",
                body: formData,
            });

            const result = await response.json();

            if (!result.errors) {
                chat_send_message_form.reset();
                clearAttachmentPreview();
            } else {
                toastr.warning(result.errors.common.msg);
            }
        });

        if (chat_message_input && chat_send_message_form) {
            chat_message_input.addEventListener("keydown", (event) => {
                if (event.key === "Enter" && !event.shiftKey) {
                    event.preventDefault();
                    chat_send_message_form.requestSubmit();
                }
            });
            chat_message_input.addEventListener("input", () => {
                emitTypingStatus();
            });
            chat_message_input.addEventListener("blur", () => {
                emitStopTyping();
            });
        }

        chat_message_list?.addEventListener("click", async (event) => {
            const menuBtn = event.target.closest(".message-menu-btn");
            if (menuBtn) {
                const menu = menuBtn.parentElement?.querySelector(".message-menu");
                const isActive = menu?.classList.contains("active");
                closeMessageMenus();
                if (!isActive && menu) {
                    const pinItem = menu.querySelector('[data-action="pin"], [data-action="unpin"]');
                    if (pinItem) {
                        const isPinned = pinnedMessages.some((message) => message.id === menu.dataset.messageId);
                        pinItem.dataset.action = isPinned ? "unpin" : "pin";
                        pinItem.textContent = isPinned ? "Unpin" : "Pin";
                    }
                    menu.classList.add("active");
                }
                return;
            }

            const menuItem = event.target.closest(".message-menu-item");
            if (!menuItem) return;
            const action = menuItem.dataset.action;
            const row = menuItem.closest(".message-row");
            const data = getMessageData(row);
            if (!data) return;
            closeMessageMenus();

            if (action === "copy") {
                const text = data.text?.trim();
                if (!text) {
                    toastr.warning("No text to copy.");
                    return;
                }
                try {
                    const ok = await copyToClipboard(text);
                    ok ? toastr.success("Message copied.") : toastr.error("Copy failed.");
                } catch (err) {
                    toastr.error("Copy failed.");
                }
                return;
            }

            if (action === "delete") {
                if (!data.id) return;
                const response = await fetch(`/inbox/message/single/${data.id}`, {
                    method: "DELETE",
                });
                const result = await response.json();
                if (!result.errors) {
                    if (row) row.remove();
                    if (pinnedMessages.some((message) => message.id === data.id)) {
                        await unpinPinnedMessage(data.id);
                    }
                } else {
                    toastr.error(result.errors.common.msg);
                }
                return;
            }

            if (action === "unpin") {
                await unpinPinnedMessage(data.id);
                return;
            }

            if (action === "pin") {
                const duration = await askPinDuration();
                if (!duration) return;
                await setPinnedMessage(data, duration);
            }
        });

        async function deleteMeassage() {
            if (!current_conversation_id) {
                toastr.warning("You don't have select any conversation to delete messages.");
                return;
            }
            if (confirm("Are you sure to delete this messages!") !== true) return;
            const response = await fetch(`/inbox/message/delete/${current_conversation_id}`, {
                method: "DELETE",
            });
            const result = await response.json();
            if (!result.errors) {
                toastr.success(result.message);
                pinnedMessages = [];
                renderPinnedMessage();
                chat_message_list.innerHTML = `<div class="message-row message-nothing flex gap-2 text-soft-color items-center justify-center h-full">
                            <h1 class="text-2xl font-bold">You don't have message</h1>
                        </div>`;
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        async function clearMessage() {
            if (!current_conversation_id) {
                toastr.warning("You don't have select any conversation to clear messages.");
                return;
            }
            if (confirm("Are you sure to clear this messages!") !== true) return;
            const response = await fetch(`/inbox/message/clear/${current_conversation_id}`, {
                method: "DELETE",
            });
            const result = await response.json();
            if (!result.errors) {
                toastr.success(result.message);
                pinnedMessages = [];
                renderPinnedMessage();
                chat_message_list.innerHTML = `<div class="message-row message-nothing flex gap-2 text-soft-color items-center justify-center h-full">
                            <h1 class="text-2xl font-bold">You don't have message</h1>
                        </div>`;
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        async function leaveGroup() {
            if (!current_conversation_id) return;
            if (confirm("Leave this group?") !== true) return;
            const response = await fetch(`/inbox/conversation/group/${current_conversation_id}/leave`, {
                method: "POST",
            });
            const result = await response.json();
            if (!result.errors) {
                toastr.success(result.message || "Left the group.");
                setTimeout(() => location.reload(), 100);
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        async function userBlock() {
            if (!participant || participant.isGroup) {
                toastr.warning("Please provide a valid person.");
                return;
            }
            const response = await fetch("/users/block", {
                method: "POST",
                body: JSON.stringify({ user_id: participant.id }),
                headers: { "Content-type": "application/json; charset=UTF-8" },
            });
            const result = await response.json();
            if (!result.errors) {
                toastr.success(result.message);
                updateBlockUnblockUi(currentUserId, result.participantUser?.blockable);
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        async function userUnblock() {
            if (!participant || participant.isGroup) {
                toastr.warning("Please provide a valid person.");
                return;
            }
            const response = await fetch("/users/unblock", {
                method: "POST",
                body: JSON.stringify({ user_id: participant.id }),
                headers: { "Content-type": "application/json; charset=UTF-8" },
            });
            const result = await response.json();
            if (!result.errors) {
                toastr.success(result.message);
                updateBlockUnblockUi(currentUserId, result.participantUser?.blockable);
            } else {
                toastr.error(result.errors.common.msg);
            }
        }

        function updateBlockUnblockUi(loggedInUserId, blockable) {
            if (!chat_message_block_container || !blocked_message_form_container) return;
            if (participant?.isGroup) {
                chat_message_block_container.innerHTML = "";
                blocked_message_form_container.innerHTML = "";
                chat_form_container.classList.remove("hidden");
                blocked_message_form_container.classList.add("hidden");
                return;
            }
            const blocked = loggedInUserId && blockable && blockable.some((blockedObj) => String(blockedObj.id) === String(loggedInUserId));
            if (blocked) {
                chat_message_block_container.innerHTML = `<div class="flex items-center gap-3 px-4 py-1 hover-bg-dark-color cursor-pointer" onclick="userUnblock()">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>Unblock</div>`;
                blocked_message_form_container.innerHTML = `<h4 class="text-soft-color">You blocked this user.</h4>`;
                chat_form_container.classList.add("hidden");
                blocked_message_form_container.classList.remove("hidden");
            } else {
                chat_message_block_container.innerHTML = `<div class="flex items-center gap-3 px-4 py-1 hover-bg-dark-color cursor-pointer" onclick="userBlock()">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>Block</div>`;
                blocked_message_form_container.innerHTML = "";
                chat_form_container.classList.remove("hidden");
                blocked_message_form_container.classList.add("hidden");
            }
        }

        if (message_search_input) {
            message_search_input.addEventListener("input", () => {
                const query = message_search_input.value.trim().toLowerCase();
                const rows = chat_message_list.querySelectorAll(".message-row:not(.message-nothing)");
                rows.forEach((row) => {
                    const textEl = row.querySelector(".message-text");
                    if (!textEl) return;
                    const raw = textEl.dataset.raw || textEl.textContent;
                    textEl.dataset.raw = raw;
                    textEl.innerHTML = escapeHtml(raw);
                });
                if (!query) return;

                let firstMatch = null;
                rows.forEach((row) => {
                    const textEl = row.querySelector(".message-text");
                    if (!textEl) return;
                    const raw = textEl.dataset.raw || textEl.textContent;
                    if (raw.toLowerCase().includes(query)) {
                        const highlighted = raw.replace(new RegExp(escapeRegex(query), "gi"), (match) => `<span class="message-highlight">${match}</span>`);
                        textEl.innerHTML = highlighted;
                        if (!firstMatch) firstMatch = row;
                    }
                });
                if (firstMatch) {
                    firstMatch.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            });
        }

        function clearAttachmentPreview() {
            if (!attachment_preview) return;
            attachment_preview.innerHTML = "";
            attachment_preview.classList.add("hidden");
            attachmentFiles = [];
            if (attachment_input) {
                attachment_input.value = "";
            }
        }

        if (attachment_input) {
            attachment_input.addEventListener("change", () => {
                attachmentFiles = Array.from(attachment_input.files || []);
                if (!attachmentFiles.length) {
                    clearAttachmentPreview();
                    return;
                }
                renderAttachmentPreview();
            });
        }

        function getAudioMimeType() {
            const candidates = [
                "audio/webm;codecs=opus",
                "audio/webm",
                "audio/ogg;codecs=opus",
                "audio/ogg",
                "audio/mp4",
            ];
            return candidates.find((type) => window.MediaRecorder && MediaRecorder.isTypeSupported(type)) || "";
        }

        async function startAudioRecording() {
            if (!navigator.mediaDevices?.getUserMedia || !window.MediaRecorder) {
                toastr.error("Audio recording is not supported in this browser.");
                return;
            }
            try {
                audioRecordStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                audioRecordChunks = [];
                const mimeType = getAudioMimeType();
                mediaRecorder = new MediaRecorder(audioRecordStream, mimeType ? { mimeType } : undefined);
                mediaRecorder.ondataavailable = (event) => {
                    if (event.data && event.data.size > 0) audioRecordChunks.push(event.data);
                };
                mediaRecorder.onstop = () => {
                    const type = mediaRecorder.mimeType || "audio/webm";
                    const extension = type.includes("ogg") ? "ogg" : type.includes("mp4") ? "m4a" : "webm";
                    const blob = new Blob(audioRecordChunks, { type });
                    const seconds = Math.max(1, Math.round((Date.now() - audioRecordStartedAt) / 1000));
                    const file = new File([blob], `voice-message-${Date.now()}.${extension}`, { type });
                    attachmentFiles.push(file);
                    syncAttachmentInput();
                    renderAttachmentPreview();
                    stopAudioTracks();
                    audioRecordChunks = [];
                    audioRecordStartedAt = null;
                    toastr.success(`Audio recorded (${seconds}s).`);
                };
                audioRecordStartedAt = Date.now();
                mediaRecorder.start();
                audio_record_btn.classList.add("is-recording");
                audio_record_btn.setAttribute("aria-label", "Stop recording");
                toastr.info("Recording audio...");
            } catch (error) {
                stopAudioTracks();
                toastr.error("Microphone permission denied.");
            }
        }

        function stopAudioTracks() {
            if (audioRecordStream) {
                audioRecordStream.getTracks().forEach((track) => track.stop());
                audioRecordStream = null;
            }
            if (audio_record_btn) {
                audio_record_btn.classList.remove("is-recording");
                audio_record_btn.setAttribute("aria-label", "Record audio message");
            }
        }

        function stopAudioRecording() {
            if (mediaRecorder && mediaRecorder.state !== "inactive") {
                mediaRecorder.stop();
            } else {
                stopAudioTracks();
            }
        }

        if (audio_record_btn) {
            audio_record_btn.addEventListener("click", () => {
                if (mediaRecorder && mediaRecorder.state === "recording") {
                    stopAudioRecording();
                } else {
                    startAudioRecording();
                }
            });
        }

        if (attachment_preview) {
            attachment_preview.addEventListener("click", (event) => {
                const removeBtn = event.target.closest(".attachment-remove-btn");
                if (!removeBtn) return;
                const index = Number(removeBtn.dataset.index);
                if (Number.isNaN(index)) return;
                attachmentFiles.splice(index, 1);
                syncAttachmentInput();
                renderAttachmentPreview();
            });
        }

        function openAttachmentViewer(src) {
            if (!attachment_viewer || !attachment_viewer_img || !src) return;
            attachment_viewer_img.src = src;
            attachment_viewer.classList.add("show");
        }

        function closeAttachmentViewer() {
            if (!attachment_viewer || !attachment_viewer_img) return;
            attachment_viewer.classList.remove("show");
            attachment_viewer_img.src = "";
        }

        if (chat_message_list) {
            chat_message_list.addEventListener("click", (event) => {
                const img = event.target.closest(".attachments img");
                if (img) {
                    openAttachmentViewer(img.getAttribute("src"));
                }
            });
        }

        if (attachment_preview) {
            attachment_preview.addEventListener("click", (event) => {
                const img = event.target.closest(".attachment-thumb img");
                if (img) {
                    openAttachmentViewer(img.getAttribute("src"));
                }
            });
        }

        if (attachment_viewer_close) {
            attachment_viewer_close.addEventListener("click", closeAttachmentViewer);
        }

        if (attachment_viewer) {
            attachment_viewer.addEventListener("click", (event) => {
                if (event.target.id === "attachment-viewer") {
                    closeAttachmentViewer();
                }
            });
        }

        if (pinned_message_container) {
            pinned_message_container.addEventListener("click", async (event) => {
                const removeBtn = event.target.closest(".pinned-remove-btn");
                if (removeBtn) {
                    await unpinPinnedMessage(removeBtn.dataset.messageId);
                    return;
                }
                if (event.target.closest(".pinned-next-btn")) {
                    activePinnedIndex = (activePinnedIndex + 1) % pinnedMessages.length;
                    renderPinnedMessage();
                    return;
                }
                const item = event.target.closest(".pinned-item");
                if (item) {
                    let targetMessageId = item.dataset.messageId;
                    if (pinnedMessages.length > 1) {
                        activePinnedIndex = (activePinnedIndex + 1) % pinnedMessages.length;
                        renderPinnedMessage();
                        targetMessageId = pinnedMessages[activePinnedIndex]?.id || targetMessageId;
                    }
                    jumpToPinnedMessage(targetMessageId);
                }
            });
        }

        document.addEventListener("click", (event) => {
            if (!event.target.closest(".message-actions")) {
                closeMessageMenus();
            }
            if (!event.target.closest(".conversation-actions")) {
                closeConversationRowMenus();
            }
            if (
                inline_add_member_panel &&
                !inline_add_member_panel.classList.contains("invisible") &&
                !event.target.closest("#inline-add-member-panel") &&
                !event.target.closest("#add-members-icon")
            ) {
                closeInlineAddMember();
            }
        });
</script>
</body>
</html>
